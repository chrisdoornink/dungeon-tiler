{
  "name": "torchboy-endless-standalone-spike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Phase 0 feasibility spike: run the shared endless GameView engine as a static Vite app with no Next.js.",
  "scripts": {
    "dev": "vite --port 4001 --host --strictPort",
